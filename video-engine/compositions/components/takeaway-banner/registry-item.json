{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "takeaway-banner",
  "type": "hyperframes:component",
  "title": "Takeaway Banner",
  "description": "A bold, full-width closing-statement banner: a sweeping accent bar draws in, then the takeaway line scales/fades up large and centered.",
  "tags": ["narrative", "banner", "takeaway", "closing"],
  "category": "narrative",
  "files": [
    {
      "path": "takeaway-banner.html",
      "target": "compositions/components/takeaway-banner/takeaway-banner.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    { "id": "text", "type": "string", "default": "Cache invalidation is the hard part -- not caching itself." },
    { "id": "accent", "type": "enum", "default": "brand", "options": ["brand", "accent", "accent-2", "accent-3", "accent-4"] },
    { "id": "bar_at", "type": "number", "default": 0.15 },
    { "id": "reveal_at", "type": "number", "default": 0.55 },
    { "id": "duration", "type": "number", "default": 5 }
  ],
  "dependencies": ["../lib/text-fit.js", "../lib/props.js", "../lib/tokens.css"]
}
