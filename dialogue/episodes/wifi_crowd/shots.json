 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, the wedding Wi-Fi was awful. Full bars, nothing loaded.",
   "s": 0,
   "e": 3.42,
   "w0": 0,
   "w1": 9
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Bars show how loud the router is. Not how busy.",
   "s": 4.02,
   "e": 6.74,
   "w0": 10,
   "w1": 19
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Busy with what?",
   "s": 7.28,
   "e": 8.04,
   "w0": 20,
   "w1": 22
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "Wi-Fi is one room, one speaker. Only one device talks at a time.",
   "s": 8.54,
   "e": 13.52,
   "w0": 23,
   "w1": 35
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "One? There were two hundred phones.",
   "s": 13.92,
   "e": 15.78,
   "w0": 36,
   "w1": 41
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "They take turns. Each listens first. If it's quiet, it talks.",
   "s": 16.3,
   "e": 20.1,
   "w0": 42,
   "w1": 52
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "And if two talk together?",
   "s": 20.62,
   "e": 21.64,
   "w0": 53,
   "w1": 57
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "Crash. Both stop, wait a random moment, try again.",
   "s": 22.24,
   "e": 25.24,
   "w0": 58,
   "w1": 66
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Why random?",
   "s": 25.9,
   "e": 26.48,
   "w0": 67,
   "w1": 68
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "Same wait, same crash. Forever.",
   "s": 27.08,
   "e": 29.06,
   "w0": 69,
   "w1": 73
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "So more phones, more crashes?",
   "s": 29.72,
   "e": 31.34,
   "w0": 74,
   "w1": 78
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "More crashes, more waiting. Everyone's turn gets thinner.",
   "s": 31.84,
   "e": 34.76,
   "w0": 79,
   "w1": 86
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Wait. So one old phone slows everyone?",
   "s": 35.3,
   "e": 37.6,
   "w0": 87,
   "w1": 93
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "A slow phone needs longer to say the same thing. Everyone waits for it.",
   "s": 38.3,
   "e": 42.6,
   "w0": 94,
   "w1": 107
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And the neighbor's Wi-Fi?",
   "s": 43.16,
   "e": 44.14,
   "w0": 108,
   "w1": 111
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Same room. The old band has three clear channels. The street shares them.",
   "s": 44.72,
   "e": 49.62,
   "w0": 112,
   "w1": 124
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "How do I fix it?",
   "s": 50,
   "e": 50.72,
   "w0": 125,
   "w1": 129
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "The fast band, or a cable. A cable gets its own room.",
   "s": 51.18,
   "e": 54.9,
   "w0": 130,
   "w1": 141
  },
  {
   "n": 19,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "So who was the slow phone at the wedding?",
   "s": 55.28,
   "e": 57.06,
   "w0": 142,
   "w1": 150
  },
  {
   "n": 20,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "Mine. Thirty minutes to send one photo of the cake.",
   "s": 57.98,
   "e": 61.28,
   "w0": 151,
   "w1": 160
  }
 ],
