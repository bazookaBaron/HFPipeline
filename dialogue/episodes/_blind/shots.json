 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, when I text Maya in London, where does it go?",
   "s": 0,
   "e": 2.02,
   "w0": 0,
   "w1": 10
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "First, to the nearest phone tower.",
   "s": 2.66,
   "e": 4.14,
   "w0": 11,
   "w1": 16
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "Through the air?",
   "s": 4.66,
   "e": 5.28,
   "w0": 17,
   "w1": 19
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Radio waves. Your phone shouts, and the tower listens.",
   "s": 5.82,
   "e": 8.48,
   "w0": 20,
   "w1": 28
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Then the tower sends it to her?",
   "s": 9.2,
   "e": 10.22,
   "w0": 29,
   "w1": 35
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Not yet. Into cables. Under the street, then under the sea.",
   "s": 10.6,
   "e": 13.74,
   "w0": 36,
   "w1": 46
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "Under the sea? I thought texts used satellites.",
   "s": 14.18,
   "e": 16.42,
   "w0": 47,
   "w1": 54
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "Mostly cables. Ninety-nine percent, between continents.",
   "s": 17.16,
   "e": 19.74,
   "w0": 55,
   "w1": 60
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "So my text goes swimming?",
   "s": 20.14,
   "e": 21.18,
   "w0": 61,
   "w1": 65
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "As light, inside glass threads.",
   "s": 21.8,
   "e": 23.48,
   "w0": 66,
   "w1": 70
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Okay. And then?",
   "s": 24.2,
   "e": 25.12,
   "w0": 71,
   "w1": 73
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "A company's computers. Like the building with your photos. They find Maya's phone and pass it on.",
   "s": 25.64,
   "e": 29.74,
   "w0": 74,
   "w1": 90
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "Like passing a note across the classroom?",
   "s": 30.22,
   "e": 31.4,
   "w0": 91,
   "w1": 97
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "Exactly. Hand to hand, right into her pocket.",
   "s": 31.92,
   "e": 33.88,
   "w0": 98,
   "w1": 105
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "How long does all that take? A minute?",
   "s": 34.42,
   "e": 35.78,
   "w0": 106,
   "w1": 113
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "Less than a second.",
   "s": 36.2,
   "e": 36.94,
   "w0": 114,
   "w1": 117
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "Then why does Maya take an hour to reply?",
   "s": 37.44,
   "e": 39.22,
   "w0": 118,
   "w1": 126
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, smiling",
   "cam": "CU",
   "text": "That part's Maya.",
   "s": 39.64,
   "e": 40.32,
   "w0": 127,
   "w1": 129
  }
 ],
