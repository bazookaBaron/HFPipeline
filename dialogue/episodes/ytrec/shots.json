   "line": 12,
   "sp": "A"
  },
  {
   "text": "a few seconds,",
   "s": 39.48,
   "e": 40.45,
   "line": 12,
   "sp": "A"
  },
  {
   "text": "it learns.",
   "s": 40.52,
   "e": 41.35,
   "line": 12,
   "sp": "A"
  },
  {
   "text": "And what I watch next...",
   "s": 41.74,
   "e": 43.13,
   "line": 13,
   "sp": "B"
  },
  {
   "text": "Feeds the next round.",
   "s": 43.45,
   "e": 44.87,
   "line": 14,
   "sp": "A"
  },
  {
   "text": "Watch, learn,",
   "s": 45.14,
   "e": 46.42,
   "line": 14,
   "sp": "A"
  },
  {
   "text": "pick again.",
   "s": 46.48,
   "e": 47.31,
   "line": 14,
   "sp": "A"
  },
  {
   "text": "A loop.",
   "s": 47.46,
   "e": 48.13,
   "line": 14,
   "sp": "A"
  },
  {
   "text": "So when it guessed right,",
   "s": 48.4,
