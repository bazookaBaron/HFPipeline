 "captions": [
  {
   "text": "Grandpa, my screen ignores my gloves.",
   "s": 0,
   "e": 1.78,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "But it works with",
   "s": 1.84,
   "e": 2.36,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "a hot dog.",
   "s": 2.42,
   "e": 3.27,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "Because the hot dog",
   "s": 3.5,
   "e": 4.3,
   "line": 2,
   "sp": "A"
  },
  {
   "text": "is more like you",
   "s": 4.36,
   "e": 5.14,
   "line": 2,
   "sp": "A"
  },
  {
   "text": "than the glove is.",
   "s": 5.2,
   "e": 6.31,
   "line": 2,
   "sp": "A"
  },
  {
   "text": "I'm a hot dog?",
   "s": 6.64,
   "e": 7.71,
   "line": 3,
   "sp": "B"
  },
  {
   "text": "Mostly salty water.",
   "s": 7.82,
   "e": 9.15,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "So is a hot dog.",
   "s": 9.44,
   "e": 10.61,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "Salty water carries electricity.",
   "s": 10.92,
   "e": 12.81,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "The screen is electric?",
   "s": 13.16,
   "e": 14.43,
   "line": 5,
   "sp": "B"
  },
  {
   "text": "Under the glass,",
   "s": 14.64,
   "e": 15.65,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "invisible wires.",
   "s": 15.72,
   "e": 17.09,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "Rows one way,",
   "s": 17.44,
   "e": 18.69,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "columns the other.",
   "s": 18.8,
   "e": 19.93,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "Like graph paper.",
   "s": 20.04,
   "e": 21.09,
   "line": 7,
   "sp": "B"
  },
  {
   "text": "Hundreds of crossings.",
   "s": 21.46,
   "e": 22.81,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "The phone charges each",
   "s": 22.92,
   "e": 23.92,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "one and checks it,",
   "s": 23.98,
   "e": 25.1,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "over a hundred times a second.",
   "s": 25.16,
   "e": 27.33,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "And my finger?",
   "s": 27.74,
   "e": 28.54,
   "line": 9,
   "sp": "B"
  },
  {
   "text": "It steals a little charge",
   "s": 28.6,
   "e": 29.6,
   "line": 10,
   "sp": "A"
  },
  {
   "text": "from the crossings under it.",
   "s": 29.66,
   "e": 31.21,
   "line": 10,
   "sp": "A"
  },
  {
   "text": "The phone sees the dip.",
   "s": 31.34,
   "e": 32.85,
   "line": 10,
   "sp": "A"
  },
  {
   "text": "That's you.",
   "s": 33.06,
   "e": 34.1,
   "line": 10,
   "sp": "A"
  },
  {
   "text": "But my finger's bigger",
   "s": 34.16,
   "e": 35.22,
   "line": 11,
   "sp": "B"
  },
  {
   "text": "than one crossing.",
   "s": 35.28,
   "e": 36.32,
   "line": 11,
   "sp": "B"
  },
  {
   "text": "So it covers a few,",
   "s": 36.38,
   "e": 37.66,
   "line": 12,
   "sp": "A"
  },
  {
   "text": "and the phone picks the middle.",
   "s": 37.72,
   "e": 39.89,
   "line": 12,
   "sp": "A"
  },
  {
   "text": "Wait. So it never",
   "s": 39.98,
   "e": 40.92,
   "line": 13,
   "sp": "B"
  },
  {
   "text": "feels me pressing?",
   "s": 40.98,
   "e": 42.11,
   "line": 13,
   "sp": "B"
  },
  {
   "text": "Not at all.",
   "s": 42.3,
   "e": 43.39,
   "line": 14,
   "sp": "A"
  },
  {
   "text": "It feels the water in you.",
   "s": 43.46,
   "e": 44.99,
   "line": 14,
   "sp": "A"
  },
  {
   "text": "And my gloves?",
   "s": 45.18,
   "e": 46.07,
   "line": 15,
   "sp": "B"
  },
  {
   "text": "Wool doesn't carry charge.",
   "s": 46.52,
   "e": 48,
   "line": 16,
   "sp": "A"
  },
  {
   "text": "To the phone,",
   "s": 48.06,
   "e": 48.82,
   "line": 16,
   "sp": "A"
  },
  {
   "text": "a glove is nobody.",
   "s": 48.88,
   "e": 50.27,
   "line": 16,
   "sp": "A"
  },
  {
   "text": "So in winter,",
   "s": 50.36,
   "e": 51.08,
   "line": 17,
   "sp": "B"
  },
  {
   "text": "I text with a hot dog.",
   "s": 51.14,
   "e": 52.49,
   "line": 17,
   "sp": "B"
  },
  {
   "text": "People in Korea did,",
   "s": 52.6,
   "e": 53.5,
   "line": 18,
   "sp": "A"
  },
  {
   "text": "one cold winter.",
   "s": 53.56,
   "e": 54.85,
   "line": 18,
   "sp": "A"
  },
  {
   "text": "Genius.",
   "s": 55.14,
   "e": 56.2,
   "line": 19,
   "sp": "B"
  },
  {
   "text": "Until lunch.",
   "s": 56.9,
   "e": 58.1,
   "line": 20,
   "sp": "A"
  }
 ],
