{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "keyword-highlighter",
  "type": "hyperframes:component",
  "title": "Keyword Highlighter",
  "description": "Body text where specific keywords highlight (fill sweep, underline growth, or color change) in sync with a reveal timestamp.",
  "tags": ["narrative", "text", "emphasis", "highlight"],
  "category": "narrative",
  "files": [
    {
      "path": "keyword-highlighter.html",
      "target": "compositions/components/keyword-highlighter/keyword-highlighter.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    { "id": "text", "type": "string", "default": "The cache stores recently accessed data close to the CPU, so repeat lookups skip the slow trip to main memory." },
    { "id": "keywords", "type": "string", "default": "cache|CPU" },
    { "id": "style", "type": "enum", "default": "fill", "options": ["fill", "underline", "color"] },
    { "id": "reveal_at", "type": "number", "default": 0.3 },
    { "id": "highlight_at", "type": "number", "default": 1.3 },
    { "id": "highlight_stagger", "type": "number", "default": 0.5 },
    { "id": "duration", "type": "number", "default": 6 }
  ],
  "dependencies": ["../lib/text-fit.js", "../lib/props.js", "../lib/tokens.css"]
}
