{
 "centroid_sim": 0.2039036899805069,
 "segments": [
  {
   "i": 0,
   "start": 0.0,
   "end": 2.92,
   "text": "Claude, the server's down. Is he okay?",
   "spk": 0,
   "sim0": 0.716,
   "sim1": 0.216
  },
  {
   "i": 1,
   "start": 4.24,
   "end": 8.54,
   "text": "Servers aren't people. It's overloaded. Requests are queuing the-",
   "spk": 1,
   "sim0": 0.225,
   "sim1": 0.841
  },
  {
   "i": 2,
   "start": 8.54,
   "end": 11.16,
   "text": "Claude, is he okay?",
   "spk": 0,
   "sim0": 0.705,
   "sim1": 0.07
  },
  {
   "i": 3,
   "start": 11.9,
   "end": 13.62,
   "text": "No, he's not okay.",
   "spk": 1,
   "sim0": 0.16,
   "sim1": 0.745
  },
  {
   "i": 4,
   "start": 14.16,
   "end": 15.0,
   "text": "What happened to him?",
   "spk": 0,
   "sim0": 0.532,
   "sim1": 0.17
  },
  {
   "i": 5,
   "start": 15.4,
   "end": 17.04,
   "text": "You posted your app on TikTok.",
   "spk": 1,
   "sim0": 0.179,
   "sim1": 0.785
  },
  {
   "i": 6,
   "start": 17.62,
   "end": 18.98,
   "text": "It got like 12 views!",
   "spk": 0,
   "sim0": 0.657,
   "sim1": 0.007
  },
  {
   "i": 7,
   "start": 19.94,
   "end": 20.8,
   "text": "12 million.",
   "spk": 0,
   "sim0": 0.255,
   "sim1": 0.108
  },
  {
   "i": 8,
   "start": 22.24,
   "end": 22.88,
   "text": "Okay.",
   "spk": 0,
   "sim0": 0.505,
   "sim1": 0.016
  },
  {
   "i": 9,
   "start": 23.68,
   "end": 25.32,
   "text": "And they all showed up at once.",
   "spk": 1,
   "sim0": 0.17,
   "sim1": 0.752
  },
  {
   "i": 10,
   "start": 25.94,
   "end": 26.98,
   "text": "How many is he holding?",
   "spk": 0,
   "sim0": 0.683,
   "sim1": 0.23
  },
  {
   "i": 11,
   "start": 26.98,
   "end": 30.36,
   "text": "90,000. He was built for 40.",
   "spk": 1,
   "sim0": 0.084,
   "sim1": 0.851
  },
  {
   "i": 12,
   "start": 31.2,
   "end": 32.08,
   "text": "40,000?",
   "spk": 0,
   "sim0": 0.412,
   "sim1": 0.08
  },
  {
   "i": 13,
   "start": 32.68,
   "end": 33.08,
   "text": "40.",
   "spk": 1,
   "sim0": 0.035,
   "sim1": 0.44
  },
  {
   "i": 14,
   "start": 34.02,
   "end": 35.16,
   "text": "Then get him a friend!",
   "spk": 0,
   "sim0": 0.463,
   "sim1": 0.087
  },
  {
   "i": 15,
   "start": 35.78,
   "end": 37.16,
   "text": "That's literally the fix.",
   "spk": 1,
   "sim0": 0.118,
   "sim1": 0.756
  },
  {
   "i": 16,
   "start": 37.88,
   "end": 38.58,
   "text": "Can we call him Kevin?",
   "spk": 0,
   "sim0": 0.565,
   "sim1": 0.182
  },
  {
   "i": 17,
   "start": 39.18,
   "end": 39.92,
   "text": "Kevin's online.",
   "spk": 1,
   "sim0": 0.245,
   "sim1": 0.618
  },
  {
   "i": 18,
   "start": 40.44,
   "end": 41.16,
   "text": "Is he okay?",
   "spk": 0,
   "sim0": 0.651,
   "sim1": 0.087
  },
  {
   "i": 19,
   "start": 41.8,
   "end": 42.48,
   "text": "Kevin's down.",
   "spk": 1,
