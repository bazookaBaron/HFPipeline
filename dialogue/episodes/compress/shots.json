 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, my folder was ten gigabytes. Zipped, it's two. Where did the other eight go?",
   "s": 0,
   "e": 4.64,
   "w0": 0,
   "w1": 14
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Nowhere. It was mostly repeating itself.",
   "s": 5.32,
   "e": 7.4,
   "w0": 15,
   "w1": 20
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Repeating how?",
   "s": 8.02,
   "e": 8.72,
   "w0": 21,
   "w1": 22
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Take la, la, la, la, la. Or just write: la, six times.",
   "s": 9.32,
   "e": 13.98,
   "w0": 23,
   "w1": 34
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "Same song, fewer letters.",
   "s": 14.34,
   "e": 15.54,
   "w0": 35,
   "w1": 38
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "And nothing lost. Unzip it, and every la comes back.",
   "s": 16.2,
   "e": 19.98,
   "w0": 39,
   "w1": 48
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "But my photos aren't la, la, la.",
   "s": 20.4,
   "e": 22.1,
   "w0": 49,
   "w1": 55
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "No. So photos get something sneakier. They throw things away.",
   "s": 22.86,
   "e": 27.28,
   "w0": 56,
   "w1": 65
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Throw away? Parts of my picture?",
   "s": 27.96,
   "e": 30.3,
   "w0": 66,
   "w1": 71
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Only what your eyes miss. You see brightness sharply, color blurrily. So it keeps the sharp part, and blurs the color.",
   "s": 30.82,
   "e": 38.68,
   "w0": 72,
   "w1": 92
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And songs?",
   "s": 39.28,
   "e": 39.86,
   "w0": 93,
   "w1": 94
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "A loud drum hides the quiet sounds beside it. You never hear them. MP3 deletes them.",
   "s": 40.38,
   "e": 46.66,
   "w0": 95,
   "w1": 110
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "It deletes what I can't hear?",
   "s": 47.08,
   "e": 48.54,
   "w0": 111,
   "w1": 116
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "pleased",
   "cam": "2S",
   "text": "Ten times smaller, and you don't notice.",
   "s": 49.08,
   "e": 51.18,
   "w0": 117,
   "w1": 123
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Wait. So it's never the real song?",
   "s": 51.86,
   "e": 53.88,
   "w0": 124,
   "w1": 130
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Close enough. Save it again and again, and you get a photocopy of a photocopy.",
   "s": 54.48,
   "e": 59.56,
   "w0": 131,
   "w1": 145
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "OTS",
   "text": "So I zip the zip, till the whole movie is one byte!",
   "s": 59.94,
   "e": 63.42,
   "w0": 146,
   "w1": 157
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "Try it. A packed suitcase doesn't shrink when you sit on it.",
   "s": 64.22,
   "e": 68.02,
   "w0": 158,
   "w1": 169
  }
 ],
