 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, how does my phone know it's me and not my twin?",
   "s": 0,
   "e": 2.6,
   "w0": 0,
   "w1": 11
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "You have a twin?",
   "s": 2.94,
   "e": 3.72,
   "w0": 12,
   "w1": 15
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "playful",
   "cam": "OTS",
   "text": "Hypothetically.",
   "s": 4.38,
   "e": 4.9,
   "w0": 16,
   "w1": 16
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "It throws over thirty thousand invisible dots at your face.",
   "s": 5.24,
   "e": 8.36,
   "w0": 17,
   "w1": 26
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "Dots? Like a photo?",
   "s": 8.92,
   "e": 9.96,
   "w0": 27,
   "w1": 30
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "No. A camera watches how the dots bend over your nose, your cheeks, your chin.",
   "s": 10.44,
   "e": 15,
   "w0": 31,
   "w1": 45
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "So it draws a map of my face.",
   "s": 15.48,
   "e": 17.08,
   "w0": 46,
   "w1": 53
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "A map of its depth. Hills and valleys. The phone stored yours once, and checks it every unlock.",
   "s": 17.86,
   "e": 24.3,
   "w0": 54,
   "w1": 71
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "So a photo of me wouldn't work?",
   "s": 24.92,
   "e": 26.56,
   "w0": 72,
   "w1": 78
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "A photo is flat. No hills, no map.",
   "s": 27.16,
   "e": 30.28,
   "w0": 79,
   "w1": 86
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "What about a mask?",
   "s": 30.84,
   "e": 31.48,
   "w0": 87,
   "w1": 90
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "A good one is hard to make. And it wants your eyes open, looking at it.",
   "s": 32.04,
   "e": 36.18,
   "w0": 91,
   "w1": 106
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And my twin? Same face, same map.",
   "s": 36.54,
   "e": 38.98,
   "w0": 107,
   "w1": 113
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "Strangers get in about one time in a million.",
   "s": 39.58,
   "e": 41.86,
   "w0": 114,
   "w1": 122
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And twins?",
   "s": 42.62,
   "e": 42.94,
   "w0": 123,
   "w1": 124
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Identical ones can fool it. Apple says so itself.",
   "s": 43.72,
   "e": 46.42,
   "w0": 125,
   "w1": 133
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "So hypothetically, my twin reads my messages?",
   "s": 47.02,
   "e": 49.62,
   "w0": 134,
   "w1": 140
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "Hypothetically, get a better passcode. And a better twin.",
   "s": 50.74,
   "e": 54.18,
   "w0": 141,
   "w1": 149
  }
 ],
