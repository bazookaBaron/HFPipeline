{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "perspective-3d-road",
  "type": "hyperframes:component",
  "title": "Perspective 3D Road",
  "description": "A road/lane receding toward a vanishing point via true CSS 3D perspective, covered in glowing pulsing rectangular blocks arranged in rows that grow denser/larger toward the viewer -- a stylized traffic-jam/congestion visual, with an optional big headline that scales in over the top as a climax.",
  "tags": ["data-metrics", "3d", "perspective", "congestion", "traffic", "load", "climax"],
  "category": "data-metrics",
  "files": [
    {
      "path": "perspective-3d-road.html",
      "target": "compositions/components/perspective-3d-road/perspective-3d-road.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    { "id": "blockRows", "type": "number", "default": 6, "min": 3, "max": 10 },
    { "id": "blocksPerRow", "type": "number", "default": 5, "min": 2, "max": 10 },
    { "id": "pulseOn", "type": "boolean", "default": true },
    { "id": "title", "type": "string", "default": "" },
    { "id": "accent", "type": "enum", "default": "accent", "options": ["brand", "accent", "accent-2", "accent-3", "accent-4"] },
    { "id": "reveal_at", "type": "number", "default": 0.3 },
    { "id": "title_at", "type": "number", "default": 3.2 },
    { "id": "duration", "type": "number", "default": 8 }
  ],
  "dependencies": ["../lib/text-fit.js", "../lib/props.js", "../lib/tokens.css"]
}
