 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, my phone says I'm at the fire. How does it know?",
   "s": 0,
   "e": 2.04,
   "w0": 0,
   "w1": 11
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "Satellites. Twenty thousand kilometres up. They only say the time.",
   "s": 2.32,
   "e": 5.42,
   "w0": 12,
   "w1": 21
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "Just the time? That's all?",
   "s": 5.62,
   "e": 6.84,
   "w0": 22,
   "w1": 26
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Over and over. Your phone hears it a tiny bit late.",
   "s": 7.08,
   "e": 9.14,
   "w0": 27,
   "w1": 37
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Late by how much?",
   "s": 9.46,
   "e": 10.22,
   "w0": 38,
   "w1": 41
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Enough to measure. Late times the speed of light is distance.",
   "s": 10.46,
   "e": 13.2,
   "w0": 42,
   "w1": 52
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "So one satellite says I'm this far from it.",
   "s": 13.56,
   "e": 15.18,
   "w0": 53,
   "w1": 61
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "A ball of possible places. Four satellites, four balls. They cross in one spot. That's you.",
   "s": 15.48,
   "e": 20.78,
   "w0": 62,
   "w1": 77
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "Why four? Three would cross.",
   "s": 20.94,
   "e": 21.9,
   "w0": 78,
   "w1": 82
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "Your phone's clock is cheap. The fourth one fixes it.",
   "s": 22.2,
   "e": 24.6,
   "w0": 83,
   "w1": 92
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Light is fast. One tiny mistake and I'm in the ocean?",
   "s": 24.82,
   "e": 27.32,
   "w0": 93,
   "w1": 103
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "A millionth of a second is three hundred metres. So the satellites carry atomic clocks, and Einstein corrects them. Thirty-eight microseconds a day.",
   "s": 27.72,
   "e": 34.06,
   "w0": 104,
   "w1": 126
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "grinning",
   "cam": "OTS",
   "text": "Einstein works for my phone?",
   "s": 34.34,
   "e": 35.38,
   "w0": 127,
   "w1": 131
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Skip him, and you drift ten kilometres a day.",
   "s": 35.6,
   "e": 37.6,
   "w0": 132,
   "w1": 140
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And in the city, between buildings?",
   "s": 37.74,
   "e": 38.9,
   "w0": 141,
   "w1": 146
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "Maps and wifi names fill the gaps.",
   "s": 39.2,
   "e": 40.68,
   "w0": 147,
   "w1": 153
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "Okay, but then why were we lost last summer?",
   "s": 41.04,
   "e": 42.58,
   "w0": 154,
   "w1": 162
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, smiling",
   "cam": "CU",
   "text": "The phone knew exactly where we were. You were the lost one.",
   "s": 42.94,
   "e": 45.7,
   "w0": 163,
   "w1": 174
  }
 ],
