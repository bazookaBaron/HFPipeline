 "sentences": [
  {
   "id": "s1",
   "text": "Here's how a content delivery network makes a site feel instant."
  },
  {
   "id": "s2",
   "text": "Your server lives in Virginia, but a user opens your page from Sydney."
  },
  {
   "id": "s3",
   "text": "Every request crosses sixteen thousand kilometres, so each image takes two hundred forty milliseconds."
  },
  {
   "id": "s4",
   "text": "A CDN copies your files to edge servers all around the world."
  },
  {
   "id": "s5",
   "text": "Now Sydney asks the nearest edge, and the image is already there."
  },
  {
   "id": "s6",
   "text": "That's a cache hit, served in twelve milliseconds."
  },
  {
   "id": "s7",
   "text": "If the edge doesn't have it yet, that's a miss."
  },
  {
   "id": "s8",
   "text": "It fetches once from the origin, then keeps a copy for everyone after."
  },
  {
   "id": "s8b",
   "text": "The next visitor from anywhere nearby gets that fast copy instantly."
  },
  {
   "id": "s9",
   "text": "On a busy site, ninety five percent of requests never touch your server."
  },
  {
   "id": "s10",
   "text": "Less distance, less load, and a faster page for everyone."
  },
  {
   "id": "s11",
   "text": "Copy it close, and serve it fast."
  }
 ],
