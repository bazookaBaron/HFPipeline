{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "deployment-dashboard",
  "type": "hyperframes:component",
  "title": "Deployment Dashboard",
  "description": "ALB listener line + routing-switch visual + two side-by-side BLUE/GREEN environment cards (version, LIVE/IDLE badge, instance health rows, traffic %), with an optional 5xx error-rate chart and an alternate users-funnel content mode -- one rich reusable visual for a blue-green-deployment narrative.",
  "tags": ["architecture", "deployment", "blue-green", "load-balancer", "dashboard", "traffic-split"],
  "category": "architecture",
  "files": [
    {
      "path": "deployment-dashboard.html",
      "target": "compositions/components/deployment-dashboard/deployment-dashboard.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    { "id": "leftLabel", "type": "string", "default": "BLUE" },
    { "id": "rightLabel", "type": "string", "default": "GREEN" },
    { "id": "leftVersion", "type": "string", "default": "v1.4.2" },
    { "id": "rightVersion", "type": "string", "default": "v2.0.1" },
    { "id": "leftLive", "type": "boolean", "default": true },
    { "id": "rightLive", "type": "boolean", "default": false },
    { "id": "leftInstances", "type": "string", "default": "[{\"id\":\"i-0a3f8c21\",\"healthy\":true},{\"id\":\"i-7b291de4\",\"healthy\":true},{\"id\":\"i-c48a02f1\",\"healthy\":true}]" },
    { "id": "rightInstances", "type": "string", "default": "[{\"id\":\"i-9f13aa02\",\"healthy\":false},{\"id\":\"i-52dd881c\",\"healthy\":false},{\"id\":\"i-e60347bb\",\"healthy\":false}]" },
    { "id": "leftTrafficPct", "type": "number", "default": 100 },
    { "id": "rightTrafficPct", "type": "number", "default": 0 },
    { "id": "showErrorChart", "type": "boolean", "default": false },
    { "id": "errorRatePct", "type": "number", "default": 0.4 },
    { "id": "errorChartTrend", "type": "enum", "default": "flat", "options": ["flat", "rising"] },
    { "id": "showUsersFunnel", "type": "boolean", "default": false },
    { "id": "listenerLabel", "type": "string", "default": "listener :443  forward" },
    { "id": "reveal_at", "type": "number", "default": 0.3 },
    { "id": "switch_at", "type": "number", "default": 1.4 },
    { "id": "duration", "type": "number", "default": 8 }
  ],
  "dependencies": ["../lib/text-fit.js", "../lib/props.js", "../lib/tokens.css"]
}
