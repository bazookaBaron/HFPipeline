 "captions": [
  {
   "text": "Grandpa, when I text",
   "s": 0,
   "e": 0.7,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "Maya in London,",
   "s": 0.76,
   "e": 1.52,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "where does it go?",
   "s": 1.58,
   "e": 2.37,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "First, to the nearest phone tower.",
   "s": 2.66,
   "e": 4.49,
   "line": 2,
   "sp": "A"
  },
  {
   "text": "Through the air?",
   "s": 4.66,
   "e": 5.63,
   "line": 3,
   "sp": "B"
  },
  {
   "text": "Radio waves.",
   "s": 5.82,
   "e": 6.78,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "Your phone shouts,",
   "s": 6.84,
   "e": 7.44,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "and the tower listens.",
   "s": 7.5,
   "e": 8.83,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "Then the tower sends",
   "s": 9.2,
   "e": 9.86,
   "line": 5,
   "sp": "B"
  },
  {
   "text": "it to her?",
   "s": 9.92,
   "e": 10.54,
   "line": 5,
   "sp": "B"
  },
  {
   "text": "Not yet.",
   "s": 10.6,
   "e": 11.16,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "Into cables.",
   "s": 11.22,
   "e": 12,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "Under the street,",
   "s": 12.06,
   "e": 12.76,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "then under the sea.",
   "s": 12.82,
   "e": 14.09,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "Under the sea?",
   "s": 14.18,
   "e": 15.09,
   "line": 7,
   "sp": "B"
  },
  {
   "text": "I thought texts used satellites.",
   "s": 15.18,
   "e": 16.77,
   "line": 7,
   "sp": "B"
  },
  {
   "text": "Mostly cables.",
   "s": 17.16,
   "e": 18.13,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "Ninety-nine percent,",
   "s": 18.2,
   "e": 18.88,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "between continents.",
   "s": 18.94,
   "e": 20.08,
   "line": 8,
   "sp": "A"
  },
