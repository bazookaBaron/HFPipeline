 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, YouTube showed me a video before I knew I wanted it.",
   "s": 0,
   "e": 2.86,
   "w0": 0,
   "w1": 11
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Did you want it?",
   "s": 3.28,
   "e": 4.14,
   "w0": 12,
   "w1": 15
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "playful",
   "cam": "OTS",
   "text": "Obviously. That's the creepy part.",
   "s": 4.66,
   "e": 6.74,
   "w0": 16,
   "w1": 20
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "Nobody read your mind. It counts. How long you watch. What you replay. What you skip.",
   "s": 7.28,
   "e": 12.32,
   "w0": 21,
   "w1": 36
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "It counts my skips?",
   "s": 12.7,
   "e": 13.88,
   "w0": 37,
   "w1": 40
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Every one. Then it picks a few hundred videos, out of millions, that might suit you.",
   "s": 14.18,
   "e": 18.94,
   "w0": 41,
   "w1": 56
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "Hundreds out of millions. Then it shows me all of them?",
   "s": 19.34,
   "e": 22.1,
   "w0": 57,
   "w1": 67
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "No. A second job scores each one: how long will you watch? The best score goes first.",
   "s": 22.7,
   "e": 28.68,
   "w0": 68,
   "w1": 84
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Not how likely I am to click?",
   "s": 29.26,
   "e": 30.78,
   "w0": 85,
   "w1": 91
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Click is cheap. Anyone clicks a shiny title. Watch time is the prize.",
   "s": 31.2,
   "e": 35.94,
   "w0": 92,
   "w1": 104
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "So a liar of a title loses?",
   "s": 36.56,
   "e": 38.1,
   "w0": 105,
   "w1": 111
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "CU",
   "text": "If you leave after a few seconds, it learns.",
   "s": 38.58,
   "e": 41,
   "w0": 112,
   "w1": 120
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And what I watch next...",
   "s": 41.74,
   "e": 42.78,
   "w0": 121,
   "w1": 125
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "Feeds the next round. Watch, learn, pick again. A loop.",
   "s": 43.45,
   "e": 47.78,
   "w0": 126,
   "w1": 135
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "So when it guessed right, I basically picked it myself.",
   "s": 48.4,
   "e": 51.16,
   "w0": 136,
   "w1": 145
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "You watched forty cat videos in a row. It was not a hard guess.",
   "s": 52.48,
   "e": 56.26,
   "w0": 146,
   "w1": 159
  }
 ],
