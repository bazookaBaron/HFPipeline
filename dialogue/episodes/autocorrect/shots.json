 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, I typed \"hello\" to my teacher. My phone sent \"jello.\"",
   "s": 0,
   "e": 3.22,
   "w0": 0,
   "w1": 10
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Your thumb landed between two keys. H and J are neighbors.",
   "s": 3.56,
   "e": 6.84,
   "w0": 11,
   "w1": 21
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "So it just picked one?",
   "s": 7.22,
   "e": 8.14,
   "w0": 22,
   "w1": 26
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "It guessed. It always guesses.",
   "s": 8.42,
   "e": 10.08,
   "w0": 27,
   "w1": 31
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Guesses how?",
   "s": 10.44,
   "e": 11,
   "w0": 32,
   "w1": 33
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "First clue: where your thumb landed. That much it knows.",
   "s": 11.36,
   "e": 14.36,
   "w0": 34,
   "w1": 43
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "What's the other clue?",
   "s": 14.68,
   "e": 15.44,
   "w0": 44,
   "w1": 47
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "The words before it. You'd just typed \"pudding.\"",
   "s": 15.82,
   "e": 18.5,
   "w0": 48,
   "w1": 55
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "thinking, sheepish",
   "cam": "OTS",
   "text": "Okay. That's fair.",
   "s": 18.78,
   "e": 19.9,
   "w0": 56,
   "w1": 58
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "Then it scores every word it knows. Thumb spot, word before, how common. Top score wins.",
   "s": 20.18,
   "e": 26.66,
   "w0": 59,
   "w1": 74
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "surprised",
   "cam": "CU",
   "text": "Every word? How many?",
   "s": 26.98,
   "e": 28.5,
   "w0": 75,
   "w1": 78
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Thousands. In a blink.",
   "s": 28.5,
   "e": 30.12,
   "w0": 79,
   "w1": 82
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "So how does it know me?",
   "s": 30.46,
   "e": 31.4,
   "w0": 83,
   "w1": 88
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "You teach it. A word you keep goes in your own list.",
   "s": 31.66,
   "e": 35,
   "w0": 89,
   "w1": 100
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "And if I undo a fix?",
   "s": 35.38,
   "e": 36.4,
   "w0": 101,
   "w1": 106
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "Then it learns it was wrong. Do that enough, and it stops.",
   "s": 36.72,
   "e": 40.26,
   "w0": 107,
   "w1": 118
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "So why does it still turn Moe into \"more\"?",
   "s": 41.22,
   "e": 43.74,
   "w0": 119,
   "w1": 127
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "MS",
   "text": "Everyone types \"more.\" Almost nobody types Moe. Nothing personal.",
   "s": 45.14,
   "e": 49.72,
   "w0": 128,
   "w1": 136
  }
 ],
