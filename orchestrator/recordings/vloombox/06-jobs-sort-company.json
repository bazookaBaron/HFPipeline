{
  "id": "jobs-sort-company",
  "url": "https://www.vloombox.in/",
  "page": "/",
  "viewport": "16x9-close",
  "ready": "!document.body.innerText.includes('Loading jobs') && /[0-9,]+ jobs/.test(document.body.innerText)",
  "cursor": {
    "start": [
      520,
      420
    ]
  },
  "setup": [
    {
      "do": "scroll",
      "toTarget": {
        "sel": "button",
        "text": "Remote"
      },
      "offset": 80,
      "dur": 0.1
    }
  ],
  "actions": [
    {
      "do": "hold",
      "dur": 0.4
    },
    {
      "do": "select",
      "target": {
        "sel": "select",
        "hasOption": "By company"
      },
      "value": "company",
      "dur": 0.6,
      "what": "opens the sort menu and picks 'By company'"
    },
    {
      "do": "waitFor",
      "js": "/[0-9,]+ jobs/.test(document.body.innerText) && !document.body.innerText.includes('Loading jobs')"
    },
    {
      "do": "hold",
      "dur": 0.3
    },
    {
      "do": "highlight",
      "target": {
        "sel": ".job-card",
        "nth": 0
      },
      "dur": 1.4,
      "pad": 3,
      "hold": 0.8,
      "at": [
        0.55,
        0.5
      ],
      "what": "listings regroup alphabetically by company"
    },
    {
      "do": "highlight",
      "target": {
        "sel": ".job-card",
        "nth": 1
      },
      "dur": 1.3,
      "pad": 3,
      "moveDur": 0.5,
      "hold": 0.7,
      "at": [
        0.55,
        0.5
      ]
    },
    {
      "do": "highlight",
      "target": {
        "sel": ".job-card",
        "nth": 2
      },
      "dur": 1.2,
      "pad": 3,
      "moveDur": 0.5,
      "hold": 0.6,
      "at": [
        0.55,
        0.5
      ]
    }
  ],
  "tags": [
    "jobs",
    "sort",
    "by company",
    "select"
  ],
  "description": "Sorting the vloombox jobs board 'By company' regroups the listings alphabetically by employer.",
  "promoLine": "Targeting specific companies? Sort vloom box dot in by company and see who is hiring right now."
}
