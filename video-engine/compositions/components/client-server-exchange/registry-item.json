{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "client-server-exchange",
  "type": "hyperframes:component",
  "title": "Client Server Exchange",
  "description": "A two-box client/server diagram with a labeled request packet traveling client -> server, then a labeled response packet traveling back.",
  "tags": ["architecture", "diagram", "network", "request-response"],
  "category": "architecture",
  "files": [
    {
      "path": "client-server-exchange.html",
      "target": "compositions/components/client-server-exchange/client-server-exchange.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    { "id": "client_label", "type": "string", "default": "Client" },
    { "id": "server_label", "type": "string", "default": "Server" },
    { "id": "request_label", "type": "string", "default": "GET /api/users" },
    { "id": "response_label", "type": "string", "default": "200 OK" },
    { "id": "accent", "type": "enum", "default": "brand", "options": ["brand", "accent", "accent-2", "accent-3", "accent-4"] },
    { "id": "request_at", "type": "number", "default": 0.6 },
    { "id": "response_at", "type": "number", "default": 2.6 },
    { "id": "duration", "type": "number", "default": 6 }
  ],
  "dependencies": ["../lib/text-fit.js", "../lib/props.js", "../lib/tokens.css"]
}
