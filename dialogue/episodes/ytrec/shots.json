 "captions": [
  {
   "text": "Grandpa, YouTube showed me",
   "s": 0,
   "e": 1.22,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "a video before I",
   "s": 1.28,
   "e": 2.06,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "knew I wanted it.",
   "s": 2.12,
   "e": 3.21,
   "line": 1,
   "sp": "B"
  },
  {
   "text": "Did you want it?",
   "s": 3.28,
   "e": 4.49,
   "line": 2,
   "sp": "A"
  },
  {
   "text": "Obviously. That's the creepy part.",
   "s": 4.66,
   "e": 7.09,
   "line": 3,
   "sp": "B"
  },
  {
   "text": "Nobody read your mind.",
   "s": 7.28,
   "e": 8.62,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "It counts.",
   "s": 8.68,
   "e": 9.46,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "How long you watch.",
   "s": 9.52,
   "e": 10.54,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "What you replay.",
   "s": 10.6,
   "e": 11.61,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "What you skip.",
   "s": 11.68,
   "e": 12.64,
   "line": 4,
   "sp": "A"
  },
  {
   "text": "It counts my skips?",
   "s": 12.7,
   "e": 14.12,
   "line": 5,
   "sp": "B"
  },
  {
   "text": "Every one.",
   "s": 14.18,
   "e": 14.83,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "Then it picks a",
   "s": 15.32,
   "e": 15.98,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "few hundred videos,",
   "s": 16.04,
   "e": 16.86,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "out of millions,",
   "s": 16.92,
   "e": 17.74,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "that might suit you.",
   "s": 17.8,
   "e": 19.28,
   "line": 6,
   "sp": "A"
  },
  {
   "text": "Hundreds out of millions.",
   "s": 19.34,
   "e": 20.69,
   "line": 7,
   "sp": "B"
  },
  {
   "text": "Then it shows me",
   "s": 20.9,
   "e": 21.52,
   "line": 7,
   "sp": "B"
  },
  {
   "text": "all of them?",
   "s": 21.58,
   "e": 22.45,
   "line": 7,
   "sp": "B"
  },
  {
   "text": "No. A second job scores",
   "s": 22.7,
   "e": 24.58,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "each one: how long",
   "s": 24.64,
   "e": 26.14,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "will you watch?",
   "s": 26.2,
   "e": 27.15,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "The best score goes first.",
   "s": 27.4,
   "e": 29.03,
   "line": 8,
   "sp": "A"
  },
  {
   "text": "Not how likely I",
   "s": 29.26,
   "e": 30.24,
   "line": 9,
   "sp": "B"
  },
  {
   "text": "am to click?",
   "s": 30.3,
   "e": 31.13,
   "line": 9,
   "sp": "B"
  },
  {
   "text": "Click is cheap.",
   "s": 31.2,
   "e": 32.39,
   "line": 10,
   "sp": "A"
  },
  {
   "text": "Anyone clicks a shiny title.",
   "s": 32.5,
   "e": 34.27,
   "line": 10,
   "sp": "A"
  },
  {
   "text": "Watch time is the prize.",
   "s": 34.54,
   "e": 36.29,
   "line": 10,
   "sp": "A"
  },
  {
   "text": "So a liar of",
   "s": 36.56,
   "e": 37.38,
   "line": 11,
   "sp": "B"
  },
  {
   "text": "a title loses?",
   "s": 37.44,
   "e": 38.45,
   "line": 11,
   "sp": "B"
  },
  {
   "text": "If you leave after",
   "s": 38.58,
