 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, a million people open the same website at once. Why doesn't it die?",
   "s": 0,
   "e": 3.68,
   "w0": 0,
   "w1": 13
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "One computer would. Instantly.",
   "s": 4.02,
   "e": 5.76,
   "w0": 14,
   "w1": 17
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "So it's not one computer?",
   "s": 6.14,
   "e": 7.3,
   "w0": 18,
   "w1": 22
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Hundreds. All running the same copy of the site.",
   "s": 7.58,
   "e": 10.3,
   "w0": 23,
   "w1": 31
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "But my phone only knocks on one door.",
   "s": 10.48,
   "e": 12.2,
   "w0": 32,
   "w1": 39
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "Yes. A man stands at that door. Like the host at a busy restaurant.",
   "s": 12.52,
   "e": 16.8,
   "w0": 40,
   "w1": 53
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "What does he do?",
   "s": 17.24,
   "e": 17.82,
   "w0": 54,
   "w1": 57
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "He points. You, table one. You, table two. Round and round.",
   "s": 18.12,
   "e": 21.8,
   "w0": 58,
   "w1": 68
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "And if table two is slow?",
   "s": 22.04,
   "e": 23.38,
   "w0": 69,
   "w1": 74
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "Then the next guest goes to the emptiest table. He keeps count.",
   "s": 23.58,
   "e": 26.4,
   "w0": 75,
   "w1": 86
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "What if a table just breaks?",
   "s": 26.68,
   "e": 27.8,
   "w0": 87,
   "w1": 92
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "2S",
   "text": "He checks every few seconds. A broken one gets no guests. Nobody notices.",
   "s": 28.12,
   "e": 32.76,
   "w0": 93,
   "w1": 105
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Wait. So the host is the one thing that can't break?",
   "s": 33.3,
   "e": 36.12,
   "w0": 106,
   "w1": 116
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "Good catch. So there are two of them.",
   "s": 36.4,
   "e": 38.74,
   "w0": 117,
   "w1": 124
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "Two hosts. Then who points people to the hosts?",
   "s": 38.92,
   "e": 41.6,
   "w0": 125,
   "w1": 133
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "Another list. That one is public.",
   "s": 41.9,
   "e": 44.08,
   "w0": 134,
   "w1": 139
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "And who checks that one?",
   "s": 44.38,
   "e": 45.54,
   "w0": 140,
   "w1": 144
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "Don't. It's hosts all the way up.",
   "s": 46.84,
   "e": 49.2,
   "w0": 145,
   "w1": 151
  }
 ],
