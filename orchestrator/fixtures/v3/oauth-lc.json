 "version": "storyboard.v3",
 "profile": "LC",
 "topic": "How OAuth login works",
 "entities": {
  "kicker": "SECURITY / OAUTH 2.0"
 },
 "sentences": [
  {
   "id": "s1",
   "text": "Here's what really happens when you click sign in with Google."
  },
  {
   "id": "s2",
   "text": "The app never sees your password; it sends you to Google instead."
  },
  {
   "id": "s3",
   "text": "You log in there, and Google asks if the app may read your email address."
  },
  {
   "id": "s3b",
   "text": "Your password stays between you and Google the entire time."
  },
  {
   "id": "s4",
   "text": "When you agree, Google redirects back with a short lived code."
  },
  {
   "id": "s5",
   "text": "The app's server trades that code for an access token, over a private channel."
  },
  {
   "id": "s5b",
   "text": "From then on, the app sends that token with every request to Google's API."
  },
  {
   "id": "s6",
   "text": "The token expires in one hour and only covers the scopes you approved."
  },
  {
   "id": "s7",
   "text": "So if the app is hacked, the attacker gets a narrow key, not your password."
  },
  {
   "id": "s8",
   "text": "That is the whole trick: delegate access, never share the secret."
  },
  {
   "id": "s9",
   "text": "Next time you see that button, you'll know exactly what it does."
  }
 ],
