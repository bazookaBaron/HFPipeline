 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, my screen ignores my gloves. But it works with a hot dog.",
   "s": 0,
   "e": 2.92,
   "w0": 0,
   "w1": 12
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Because the hot dog is more like you than the glove is.",
   "s": 3.5,
   "e": 5.96,
   "w0": 13,
   "w1": 24
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "I'm a hot dog?",
   "s": 6.64,
   "e": 7.36,
   "w0": 25,
   "w1": 28
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Mostly salty water. So is a hot dog. Salty water carries electricity.",
   "s": 7.82,
   "e": 12.46,
   "w0": 29,
   "w1": 40
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "The screen is electric?",
   "s": 13.16,
   "e": 14.08,
   "w0": 41,
   "w1": 44
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "Under the glass, invisible wires. Rows one way, columns the other.",
   "s": 14.64,
   "e": 19.58,
   "w0": 45,
   "w1": 55
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "Like graph paper.",
   "s": 20.04,
   "e": 20.74,
   "w0": 56,
   "w1": 58
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "Hundreds of crossings. The phone charges each one and checks it, over a hundred times a second.",
   "s": 21.46,
   "e": 26.98,
   "w0": 59,
   "w1": 75
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And my finger?",
   "s": 27.74,
   "e": 28.36,
   "w0": 76,
   "w1": 78
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "It steals a little charge from the crossings under it. The phone sees the dip. That's you.",
   "s": 28.6,
   "e": 33.76,
   "w0": 79,
   "w1": 95
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "But my finger's bigger than one crossing.",
   "s": 34.16,
   "e": 36.02,
   "w0": 96,
   "w1": 102
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "So it covers a few, and the phone picks the middle.",
   "s": 36.38,
   "e": 39.54,
   "w0": 103,
   "w1": 113
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Wait. So it never feels me pressing?",
   "s": 39.98,
   "e": 41.76,
   "w0": 114,
   "w1": 120
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Not at all. It feels the water in you.",
   "s": 42.3,
   "e": 44.64,
   "w0": 121,
   "w1": 129
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And my gloves?",
   "s": 45.18,
   "e": 45.72,
   "w0": 130,
   "w1": 132
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "Wool doesn't carry charge. To the phone, a glove is nobody.",
   "s": 46.52,
   "e": 49.92,
   "w0": 133,
   "w1": 143
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "So in winter, I text with a hot dog.",
   "s": 50.36,
   "e": 52.14,
   "w0": 144,
   "w1": 152
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "People in Korea did, one cold winter.",
   "s": 52.6,
   "e": 54.5,
   "w0": 153,
   "w1": 159
  },
  {
   "n": 19,
   "sp": "B",
   "beat": "grinning",
   "cam": "OTS",
   "text": "Genius.",
   "s": 55.14,
   "e": 55.85,
   "w0": 160,
   "w1": 160
  },
  {
   "n": 20,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "Until lunch.",
   "s": 56.9,
   "e": 57.75,
   "w0": 161,
   "w1": 162
  }
 ],
