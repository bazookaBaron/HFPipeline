{
  "id": "dsa-company-google",
  "url": "https://www.vloombox.in/dsa",
  "page": "/dsa",
  "viewport": "16x9-close",
  "ready": "document.querySelectorAll('a[href*=\"leetcode.com/problems\"]').length >= 3",
  "cursor": {
    "start": [
      700,
      380
    ]
  },
  "actions": [
    {
      "do": "hold",
      "dur": 0.4
    },
    {
      "do": "click",
      "target": {
        "sel": "span",
        "text": "Company…"
      },
      "dur": 0.8,
      "caret": true,
      "what": "opens the company filter"
    },
    {
      "do": "type",
      "text": "Google",
      "cps": 8,
      "what": "types 'Google'"
    },
    {
      "do": "hold",
      "dur": 0.5
    },
    {
      "do": "click",
      "target": {
        "sel": "div",
        "text": "Google",
        "near": [
          880,
          250
        ]
      },
      "dur": 0.6,
      "what": "picks Google from the suggestions"
    },
    {
      "do": "waitFor",
      "idle": true,
      "settle": 0.4
    },
    {
      "do": "click",
      "target": {
        "sel": "h1",
        "textIncludes": "DSA Problems",
        "offset": [
          260,
          0
        ]
      },
      "dur": 0.6
    },
    {
      "do": "waitFor",
      "idle": true
    },
    {
      "do": "hold",
      "dur": 0.3
    },
    {
      "do": "highlight",
      "target": {
        "sel": "*",
        "textMatch": "^GOOGLE"
      },
      "dur": 1.3,
      "pad": 4,
      "hold": 0.7,
      "what": "Google filter chip applied"
    },
    {
      "do": "highlight",
      "target": {
        "sel": "a",
        "text": "Tree Diameter",
        "up": 3
      },
      "tight": false,
      "dur": 1.5,
      "pad": 5,
      "hold": 0.9,
      "what": "list narrows to problems Google has asked"
    }
  ],
  "tags": [
    "dsa",
    "company filter",
    "google",
    "typing",
    "leetcode"
  ],
  "description": "On the vloombox DSA page the company filter is set to Google and the problem list narrows to Google's questions.",
  "promoLine": "Interviewing at Google? vloom box dot in shows the exact DSA problems Google asks."
}
