 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "playful",
   "cam": "CU",
   "text": "Grandpa, I use Incognito. Nobody sees what I browse.",
   "s": 0,
   "e": 2.62,
   "w0": 0,
   "w1": 8
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Nobody on your phone. Everybody else sees it.",
   "s": 3.26,
   "e": 5.96,
   "w0": 9,
   "w1": 16
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "Everybody? Who?",
   "s": 6.3,
   "e": 7.44,
   "w0": 17,
   "w1": 18
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "The website, first. It gets your internet address, like any visitor.",
   "s": 8.04,
   "e": 11.72,
   "w0": 19,
   "w1": 29
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And the router?",
   "s": 12.12,
   "e": 12.58,
   "w0": 30,
   "w1": 32
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Every request goes through the router, then your provider. Think postman. He reads the address on every envelope.",
   "s": 12.98,
   "e": 19.18,
   "w0": 33,
   "w1": 50
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "Then what does Incognito hide?",
   "s": 19.56,
   "e": 21.08,
   "w0": 51,
   "w1": 55
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "Your history. Close the window, and your phone forgets the visit.",
   "s": 21.76,
   "e": 25.62,
   "w0": 56,
   "w1": 66
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "Forgets. That's all?",
   "s": 26.26,
   "e": 27.76,
   "w0": 67,
   "w1": 69
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Like wiping the table. The meal still happened. The waiter saw it.",
   "s": 28.32,
   "e": 32.68,
   "w0": 70,
   "w1": 81
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Wait. Even if I'm logged in?",
   "s": 33.02,
   "e": 34.56,
   "w0": 82,
   "w1": 87
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "Then you've told them your name. They file it under you.",
   "s": 35.02,
   "e": 37.88,
   "w0": 88,
   "w1": 98
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And at school? At work?",
   "s": 38.28,
   "e": 39.4,
   "w0": 99,
   "w1": 103
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Whoever runs that network can log it. Incognito can't touch them.",
   "s": 39.94,
   "e": 43.46,
   "w0": 104,
   "w1": 114
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "So what's it good for?",
   "s": 43.9,
   "e": 44.7,
   "w0": 115,
   "w1": 119
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "Hiding a birthday present from your sister.",
   "s": 45.12,
   "e": 46.84,
   "w0": 120,
   "w1": 126
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "That's all?",
   "s": 47.3,
   "e": 47.8,
   "w0": 127,
   "w1": 128
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "The shoe shop still knows. Your sister doesn't.",
   "s": 48.54,
   "e": 51.48,
   "w0": 129,
   "w1": 136
  }
 ],
