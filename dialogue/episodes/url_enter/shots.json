 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, I press Enter and the page is there in half a second. What happened?",
   "s": 0,
   "e": 3.36,
   "w0": 0,
   "w1": 14
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "First, the computer asks where that name lives. It has no idea.",
   "s": 4,
   "e": 7.82,
   "w0": 15,
   "w1": 26
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Asks who?",
   "s": 8.48,
   "e": 9.06,
   "w0": 27,
   "w1": 28
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "A phone book for the internet. Name in, number out. It's called DNS.",
   "s": 9.46,
   "e": 13.98,
   "w0": 29,
   "w1": 41
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "What kind of number?",
   "s": 14.66,
   "e": 15.48,
   "w0": 42,
   "w1": 45
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "An address, like a street. Now it knows which machine to call.",
   "s": 15.88,
   "e": 19.56,
   "w0": 46,
   "w1": 57
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "So it starts talking?",
   "s": 20,
   "e": 20.8,
   "w0": 58,
   "w1": 61
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "First, a handshake. Hello. Hello back. Okay, go. Three tiny messages.",
   "s": 21.38,
   "e": 27.06,
   "w0": 62,
   "w1": 72
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "Hello? To a computer?",
   "s": 27.78,
   "e": 28.96,
   "w0": 73,
   "w1": 76
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Computers are polite.",
   "s": 29.56,
   "e": 30.68,
   "w0": 77,
   "w1": 79
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And the little padlock?",
   "s": 31.18,
   "e": 32.28,
   "w0": 80,
   "w1": 83
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "Then they agree on a secret code, out in the open. The padlock means it worked.",
   "s": 32.86,
   "e": 37.26,
   "w0": 84,
   "w1": 99
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Wait. I haven't even asked for the page yet?",
   "s": 37.76,
   "e": 39.76,
   "w0": 100,
   "w1": 108
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Now you ask. One line: give me this page. Back comes the skeleton, called HTML.",
   "s": 40.3,
   "e": 45.98,
   "w0": 109,
   "w1": 123
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "Just a skeleton?",
   "s": 46.68,
   "e": 47.64,
   "w0": 124,
   "w1": 126
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "It lists pictures, styles, scripts. The browser fetches each one, then paints the page.",
   "s": 48.1,
   "e": 53.6,
   "w0": 127,
   "w1": 140
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "OTS",
   "text": "All of that in half a second?",
   "s": 54.1,
   "e": 55.54,
   "w0": 141,
   "w1": 147
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Usually less.",
   "s": 55.96,
   "e": 56.74,
   "w0": 148,
   "w1": 149
  },
  {
   "n": 19,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "Then why does my news site take five seconds?",
   "s": 57.16,
   "e": 59.58,
   "w0": 150,
   "w1": 158
  },
  {
   "n": 20,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "The page arrived in half a second. The ads are still shaking hands.",
   "s": 60.64,
   "e": 64.24,
   "w0": 159,
   "w1": 171
  }
 ],
