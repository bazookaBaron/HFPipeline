    { "id": "s1", "text": "Right now, blue serves every single user." },
    { "id": "s2", "text": "We deploy version two point one to green, while nobody is watching." },
    { "id": "s3", "text": "Its three instances boot, pass health checks, and turn healthy." },
    { "id": "s4", "text": "Then the load balancer shifts ten percent of traffic to green." },
    { "id": "s5", "text": "Suddenly, one instance starts throwing errors." },
    { "id": "s6", "text": "So we roll back instantly, and every user is on blue again." },
    { "id": "s7", "text": "After the fix, we flip all traffic to green, and blue goes idle." }
