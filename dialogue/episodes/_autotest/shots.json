 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, where do my photos go when I upload them?",
   "s": 0,
   "e": 1.8,
   "w0": 0,
   "w1": 9
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "To a building full of computers.",
   "s": 2.16,
   "e": 3.46,
   "w0": 10,
   "w1": 15
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "surprised",
   "cam": "CU",
   "text": "A building? I thought they went to the cloud.",
   "s": 3.92,
   "e": 5.6,
   "w0": 16,
   "w1": 24
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "The cloud is a building.",
   "s": 5.96,
   "e": 7.1,
   "w0": 25,
   "w1": 29
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "confused",
   "cam": "CU",
   "text": "Not a real cloud?",
   "s": 7.52,
   "e": 8.4,
   "w0": 30,
   "w1": 33
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "friendly",
   "cam": "MS",
   "text": "No. Just a huge room of computers, with a lot of fans to keep them cool.",
   "s": 8.96,
   "e": 12.94,
   "w0": 34,
   "w1": 49
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Whose computers?",
   "s": 13.54,
   "e": 13.98,
   "w0": 50,
   "w1": 51
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "A company's. Google, Apple, Amazon. You just rent a little space.",
   "s": 14.52,
   "e": 18.12,
   "w0": 52,
   "w1": 62
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "a bit shocked",
   "cam": "CU",
   "text": "So my photos live in someone else's computer?",
   "s": 18.6,
   "e": 20.5,
   "w0": 63,
   "w1": 70
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "reassuring",
   "cam": "2S",
   "text": "Yes. And they keep spare copies. If one computer breaks, your photos are still safe.",
   "s": 21.02,
   "e": 26.02,
   "w0": 71,
   "w1": 85
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "impressed",
   "cam": "CU",
   "text": "Like a spare key?",
   "s": 26.54,
   "e": 27.26,
   "w0": 86,
   "w1": 89
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "Exactly like a spare key.",
   "s": 27.62,
   "e": 28.9,
   "w0": 90,
   "w1": 94
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "thinking",
   "cam": "CU",
   "text": "So that's why I can open them on any phone.",
   "s": 28.9,
   "e": 31,
   "w0": 95,
   "w1": 104
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "Right. Your phone doesn't keep the photo. It just shows it to you.",
   "s": 31.62,
   "e": 34.44,
   "w0": 105,
   "w1": 117
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "So the cloud is just... someone else's computer.",
   "s": 34.88,
   "e": 37.44,
   "w0": 118,
   "w1": 125
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "proud",
   "cam": "MS",
   "text": "Now you've got it.",
   "s": 37.72,
   "e": 38.42,
   "w0": 126,
   "w1": 129
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "worried, funny",
   "cam": "CU",
   "text": "Does the building know I took forty selfies?",
   "s": 38.68,
   "e": 40.18,
   "w0": 130,
   "w1": 137
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, smiling",
   "cam": "MS",
   "text": "Forty-one.",
   "s": 40.68,
   "e": 41.04,
   "w0": 138,
   "w1": 138
  }
 ],
