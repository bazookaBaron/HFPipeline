{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "browser-window",
  "type": "hyperframes:component",
  "title": "Browser Window",
  "description": "A browser chrome card with a typing URL bar, a text-fit-protected heading, and staggered skeleton content rows -- for showing a web page / URL beat in narration.",
  "tags": ["software-mockup", "browser", "device", "chrome", "url", "foundation-adjacent"],
  "category": "software-mockups",
  "files": [
    {
      "path": "browser-window.html",
      "target": "compositions/components/browser-window/browser-window.html",
      "type": "hyperframes:composition"
    }
  ],
  "variables": [
    { "id": "url", "type": "string", "default": "https://example.com/dashboard" },
    { "id": "heading", "type": "string", "default": "Welcome back" },
    { "id": "row_count", "type": "number", "default": 3, "min": 0, "max": 4 },
    { "id": "accent", "type": "enum", "default": "brand", "options": ["brand", "accent", "accent-2", "accent-3", "accent-4"] },
    { "id": "type_at", "type": "number", "default": 0.3 },
    { "id": "type_duration", "type": "number", "default": 1.6 },
    { "id": "content_at", "type": "number", "default": 2.2 },
    { "id": "duration", "type": "number", "default": 6 }
  ],
  "dependencies": ["../lib/text-fit.js", "../lib/props.js", "../lib/tokens.css"]
}
