 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "Grandpa, my phone said thirty percent. Then it died. Out in the snow.",
   "s": 0,
   "e": 3.94,
   "w0": 0,
   "w1": 12
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "It wasn't dead. It was cold.",
   "s": 4.58,
   "e": 6.74,
   "w0": 13,
   "w1": 18
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Cold and empty are different?",
   "s": 7.28,
   "e": 8.68,
   "w0": 19,
   "w1": 23
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Very. Inside the battery is a liquid, and tiny lithium bits swim through it. That swimming is your power.",
   "s": 9.24,
   "e": 16.1,
   "w0": 24,
   "w1": 42
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "Swimming. Okay.",
   "s": 16.82,
   "e": 18,
   "w0": 43,
   "w1": 44
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "pleased",
   "cam": "MS",
   "text": "Now freeze it. The liquid turns thick, like honey.",
   "s": 18.52,
   "e": 21.6,
   "w0": 45,
   "w1": 53
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "Honey?",
   "s": 22.2,
   "e": 22.36,
   "w0": 54,
   "w1": 54
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "They still swim. Just slowly. The phone wants power now, and they can't get there in time.",
   "s": 23.04,
   "e": 29.14,
   "w0": 55,
   "w1": 71
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "confused",
   "cam": "OTS",
   "text": "So where did the thirty percent go?",
   "s": 29.66,
   "e": 31.18,
   "w0": 72,
   "w1": 78
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Nowhere. It's stuck in the honey.",
   "s": 31.92,
   "e": 33.72,
   "w0": 79,
   "w1": 84
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Then why does the phone quit?",
   "s": 34.1,
   "e": 35.28,
   "w0": 85,
   "w1": 90
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "Slow swimmers push weakly. The voltage sags. Under a certain line, the phone shuts itself off to stay safe.",
   "s": 35.74,
   "e": 42.8,
   "w0": 91,
   "w1": 109
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "shocked",
   "cam": "CU",
   "text": "With thirty percent still in there?",
   "s": 43.16,
   "e": 44.94,
   "w0": 110,
   "w1": 115
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "Warm it up, the honey thins, and the thirty percent comes back.",
   "s": 45.6,
   "e": 49.06,
   "w0": 116,
   "w1": 127
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Warm it how?",
   "s": 49.66,
   "e": 50.38,
   "w0": 128,
   "w1": 130
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Inside your coat. Close to you.",
   "s": 50.96,
   "e": 52.9,
   "w0": 131,
   "w1": 136
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "OTS",
   "text": "So the battery isn't broken.",
   "s": 53.44,
   "e": 54.8,
   "w0": 137,
   "w1": 141
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "Just slow. Like you before breakfast.",
   "s": 55.73,
   "e": 58.5,
   "w0": 142,
   "w1": 147
  }
 ],
