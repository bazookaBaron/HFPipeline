 "lines": [
  {
   "n": 1,
   "sp": "B",
   "beat": "curious",
   "cam": "CU",
   "text": "Grandpa, why does my movie go blurry, then sharp again?",
   "s": 0,
   "e": 2.66,
   "w0": 0,
   "w1": 9
  },
  {
   "n": 2,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Because it isn't one movie. It's a pile of little pieces.",
   "s": 3.38,
   "e": 6.6,
   "w0": 10,
   "w1": 20
  },
  {
   "n": 3,
   "sp": "B",
   "beat": "surprised",
   "cam": "OTS",
   "text": "Pieces of a movie?",
   "s": 7.28,
   "e": 8.06,
   "w0": 21,
   "w1": 24
  },
  {
   "n": 4,
   "sp": "A",
   "beat": "warm",
   "cam": "MS",
   "text": "A few seconds each. And every piece is stored in several qualities. Small and blurry. Big and sharp.",
   "s": 8.64,
   "e": 15.66,
   "w0": 25,
   "w1": 42
  },
  {
   "n": 5,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "So who decides which one I get?",
   "s": 16.32,
   "e": 17.74,
   "w0": 43,
   "w1": 49
  },
  {
   "n": 6,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Your player. Before each piece, it checks how fast the last one arrived.",
   "s": 18.29,
   "e": 22.62,
   "w0": 50,
   "w1": 62
  },
  {
   "n": 7,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "And if the wifi is slow?",
   "s": 23.12,
   "e": 24.24,
   "w0": 63,
   "w1": 68
  },
  {
   "n": 8,
   "sp": "A",
   "beat": "firm, light",
   "cam": "MS",
   "text": "It asks for the small piece. Less to carry, so it arrives on time.",
   "s": 25,
   "e": 29.18,
   "w0": 69,
   "w1": 82
  },
  {
   "n": 9,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Why not wait for the sharp one?",
   "s": 29.88,
   "e": 31.14,
   "w0": 83,
   "w1": 89
  },
  {
   "n": 10,
   "sp": "A",
   "beat": "amused",
   "cam": "MS",
   "text": "Then the picture freezes. A blur you forgive. A spinning circle, never.",
   "s": 31.84,
   "e": 36.62,
   "w0": 90,
   "w1": 101
  },
  {
   "n": 11,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "So it just guesses?",
   "s": 37.04,
   "e": 37.9,
   "w0": 102,
   "w1": 105
  },
  {
   "n": 12,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "CU",
   "text": "It keeps a cushion. Seconds of movie, downloaded ahead of what you're watching.",
   "s": 38.32,
   "e": 42.38,
   "w0": 106,
   "w1": 118
  },
  {
   "n": 13,
   "sp": "B",
   "beat": "thinking",
   "cam": "OTS",
   "text": "And a fat cushion means sharp?",
   "s": 42.9,
   "e": 44.3,
   "w0": 119,
   "w1": 124
  },
  {
   "n": 14,
   "sp": "A",
   "beat": "warm",
   "cam": "2S",
   "text": "Fat cushion, it risks the big piece. Thin cushion, it plays safe.",
   "s": 44.72,
   "e": 49.34,
   "w0": 125,
   "w1": 136
  },
  {
   "n": 15,
   "sp": "B",
   "beat": "curious",
   "cam": "OTS",
   "text": "Then the wifi comes back, and it's sharp again.",
   "s": 49.82,
   "e": 51.98,
   "w0": 137,
   "w1": 145
  },
  {
   "n": 16,
   "sp": "A",
   "beat": "matter-of-fact",
   "cam": "MS",
   "text": "Piece by piece. Nobody has to tell you.",
   "s": 52.62,
   "e": 55.14,
   "w0": 146,
   "w1": 153
  },
  {
   "n": 17,
   "sp": "B",
   "beat": "grinning",
   "cam": "CU",
   "text": "So the blur is it looking after me?",
   "s": 55.48,
   "e": 57.46,
   "w0": 154,
   "w1": 161
  },
  {
   "n": 18,
   "sp": "A",
   "beat": "dry, flat",
   "cam": "CU",
   "text": "It's looking after your patience. Which was never great.",
   "s": 58.52,
   "e": 61.68,
   "w0": 162,
   "w1": 170
  }
 ],
