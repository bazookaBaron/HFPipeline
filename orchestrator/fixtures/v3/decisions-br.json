 "sentences": [
  { "id": "s1", "text": "What does a tool router actually do inside an AI agent?" },
  { "id": "s2", "text": "Your agent can search the web, run code, query a database, or send an email." },
  { "id": "s3", "text": "Before every step, something has to pick exactly one of those tools." },
  { "id": "s4", "text": "Most teams just ask the big model, and it writes a paragraph about its plan." },
  { "id": "s5", "text": "Then your code has to dig the tool name out of that prose." },
  { "id": "s6", "text": "A router skips the essay: you list the tools and it returns one choice." },
  { "id": "s7", "text": "It even attaches a confidence, like ninety two percent for web search." },
  { "id": "s8", "text": "That answer drops straight into your app as structured data." },
  { "id": "s9", "text": "The same trick guards a shell command before the agent runs it." },
  { "id": "s10", "text": "Allow it, ask a human, or block it, decided in milliseconds." },
  { "id": "s11", "text": "The big model takes seconds, so every tiny choice gets slower and pricier." },
  { "id": "s12", "text": "Remember it this way: big models write, routers decide." }
 ],
